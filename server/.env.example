DATABASE_URL="postgresql://eventsense:eventsense@localhost:5432/eventsense?schema=public"
DATABASE_URL_UNPOOLED="postgresql://eventsense:eventsense@localhost:5432/eventsense?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="1d"
CLIENT_URL="http://localhost:3001"
ADMIN_SIGNUP_CODE="replace-with-admin-code"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
PORT=3002
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Neon Auth JWKS (Google sign-in): NEON_AUTH_BASE_URL + /.well-known/jwks.json
NEON_AUTH_JWKS_URL=

# Email (Resend). Without a verified domain Resend only delivers to the account owner, so MAIL_REDIRECT_TO sends everything there.
RESEND_API_KEY=
MAIL_FROM=EventSense <onboarding@resend.dev>
MAIL_REDIRECT_TO=

# Vercel cron auth (Vercel sends it as a Bearer token)
CRON_SECRET=
